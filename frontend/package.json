{
  "name": "gui-starter-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "api:export": "cd ../backend && poetry run python scripts/export_openapi.py",
    "api:types": "openapi-typescript openapi/openapi.json -o src/types/generated.ts --default-non-nullable false",
    "api:schema": "node scripts/generateZodSchema.mjs",
    "generate:api": "npm run api:export && npm run api:schema && npm run api:types",
    "predev": "npm run generate:api",
    "prebuild": "npm run generate:api"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.0",
    "axios": "^1.13.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^14.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "json-schema-to-zod": "^2.8.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^4.1.9"
  }
}
